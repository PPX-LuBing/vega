[Unit]
Description=Vega subscription server (loopback; put HTTPS reverse proxy in front)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sbx-panel serve --listen 127.0.0.1:8080
WorkingDirectory=/var/lib/sbx-panel
StateDirectory=sbx-panel
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
